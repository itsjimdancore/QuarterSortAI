# GROQ_API_KEY: Required for Groq AI API calls (AI Audit Report + document insights).
# Users configure this via the Secrets panel in the AI Studio UI.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL (optional): Groq model ID used for AI calls.
# Defaults to "openai/gpt-oss-120b". Override if that model is unavailable for your key tier.
# GROQ_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── OCR fallback (Python RapidOCR, api/ocr.py) ──
# Files are only uploaded when browser OCR is weak and this is enabled.
# VITE_SERVER_OCR_ENABLED="false"
# Base URL of the OCR service. Leave empty for same-origin /api/ocr.
# VITE_OCR_API_URL=""
# Dev only: where server.ts proxies /api/ocr* (default http://localhost:8000)
# OCR_DEV_TARGET="http://localhost:8000"
